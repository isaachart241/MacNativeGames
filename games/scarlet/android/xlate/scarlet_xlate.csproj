<!-- Thor port: the shader translator with the Vulkan service mode (the service-vk mode of totk_xlate). Built by build.sh, which puts
     this file next to the translator's sources (games/totk/tools/totk_xlate/*.cs) and this folder's VkService.cs and
     ManagedSha256.cs, with vendor/ryujinx patched as Scarlet's Mac translator is. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>totk_xlate</AssemblyName>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DefineConstants>$(DefineConstants);SCARLET_VK</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(RyuSrc)/src/Ryujinx.Graphics.Shader/Ryujinx.Graphics.Shader.csproj" />
    <ProjectReference Include="$(RyuSrc)/src/Ryujinx.Common/Ryujinx.Common.csproj" />
  </ItemGroup>
</Project>
